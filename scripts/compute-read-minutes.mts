 * SPDX-License-Identifier: Apache-2.0
 *
 * Computes average per-chapter reading time (in minutes at 225 words/minute)
 * for all 66 books of the Bible from the committed static text files under
 * public/bible/{VERSION}/{bookId}/{chapter}.json.
 *
 * Usage:
 *   npx tsx scripts/compute-read-minutes.mts [VERSION]
 */

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { CATEGORIES, BOLLS_BIBLE_BOOK_IDS } from '../src/constants.ts';
import { cleanVerseText } from '../src/lib/chapterText.ts';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(__dirname, '..');

export const WORDS_PER_MINUTE = 225;

export interface BookReadMinutesReport {
  /** Integer fallback table for BOOK_READ_MINUTES in src/constants.ts */
  rounded: Record<string, number>;
  /** 1-decimal average of per-chapter rounded read times (e.g. Genesis 3.2, Job 1.9, Proverbs 2.0, Jude 3.0) */
  averages: Record<string, number>;
  /** Exact unrounded average of per-chapter read times */
  exactAverages: Record<string, number>;
}

/**
 * Compute per-chapter reading time for a single static chapter file using the
 * exact formula in src/lib/bibleCache.ts (`getChapterInfo`).
 */
export function computeChapterReadTimeFromFile(versionCode: string, bookName: string, chapter: number): number {
  const bookId = BOLLS_BIBLE_BOOK_IDS[bookName];
  if (!bookId) throw new Error(`Unknown book: ${bookName}`);
  const filePath = path.join(ROOT, 'public', 'bible', versionCode, String(bookId), `${chapter}.json`);
  const raw = JSON.parse(fs.readFileSync(filePath, 'utf8'));
  const verses: Array<{ verse?: number; text?: string }> = Array.isArray(raw)
    ? raw.map((v) => ({ verse: Number(v.verse), text: cleanVerseText(v.text || '') }))
    : raw.verses;

  const wordCount = verses.reduce((acc, v) => acc + (v.text ? v.text.split(/\s+/).length : 0), 0);
  return Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE));
}

export function computeBookReadMinutes(versionCode = 'NCV'): BookReadMinutesReport {
  const rounded: Record<string, number> = {};
  const averages: Record<string, number> = {};
  const exactAverages: Record<string, number> = {};

  for (const cat of CATEGORIES) {
    for (const book of cat.books) {
      let totalChapterReadMins = 0;
      for (let ch = 1; ch <= book.chapters; ch++) {
        totalChapterReadMins += computeChapterReadTimeFromFile(versionCode, book.name, ch);
      }
      const exact = totalChapterReadMins / book.chapters;
      exactAverages[book.name] = exact;
      averages[book.name] = Math.round(exact * 10) / 10;
      rounded[book.name] = Math.max(1, Math.round(exact));
    }
  }

  return { rounded, averages, exactAverages };
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const version = process.argv[2] || 'NCV';
  const { rounded, averages } = computeBookReadMinutes(version);
  console.log(`// Generated by scripts/compute-read-minutes.mts (${version}, ${WORDS_PER_MINUTE} wpm)`);
  console.log('export const BOOK_READ_MINUTES: Record<string, number> = {');
  for (const cat of CATEGORIES) {
    console.log(`  // ${cat.name}`);
    const entries = cat.books.map((b) => `'${b.name}': ${rounded[b.name]} /* ${averages[b.name].toFixed(1)} */`);
    console.log(`  ${entries.join(', ')},`);
  }
  console.log('};');
}
