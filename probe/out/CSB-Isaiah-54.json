"text": "For the children of the desolate one will be more"
},
{
"tag": "span",
"class": [
"text",
"Isa-54-1"
],
"id": null,
"text": "than the children of the married woman,” ( B )"
},
{
"tag": "sup",
"class": [
"crossreference"
],
"id": null,
"text": "( B )"
},
{
"tag": "span",
"class": [
"text",
"Isa-54-1"
],
"id": null,
"text": "says the Lord ."
},
{
"tag": "span",
"class": [
"small-caps",
"divine-name"
],
"id": null,
"text": "Lord"
},
{
