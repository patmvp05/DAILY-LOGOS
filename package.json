{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-conflict.mts && tsx scripts/sim-sync.mts && tsx scripts/test-chapter-text.mts && tsx scripts/test-chapter-fetch.mts && tsx scripts/test-prefetch-bible.mts && tsx scripts/test-verse-copy.mts && tsx scripts/test-devotional-content.mts && tsx scripts/test-progress-stats.mts && tsx scripts/test-resume-reading.mts && tsx scripts/test-sprint.mts && tsx scripts/test-sync-status.mts && tsx scripts/test-bsb-parser.mts",
    "test:rules": "firebase emulators:exec --only firestore --project daily-logos-rules-test \"tsx scripts/test-rules-sprints.mts\"",
    "test:rules-merge": "firebase emulators:exec --only firestore --project daily-logos-merge-test \"tsx scripts/test-sprint-merge.mts\"",
    "test:sim": "tsx scripts/sim-sync.mts",
    "fuzz:ui": "vite build && node scripts/fuzz-ui.mjs",
    "emulators": "firebase emulators:start --only auth,firestore",
    "dev:emulator": "VITE_USE_FIREBASE_EMULATOR=true vite --port=3000 --host=0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.56.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^1.2.0"
  }
}
